# Copy this file to the Hostinger environment-variable editor.
# Replace every placeholder marked CHANGE_ME with real deployment values.

NODE_ENV=production
APP_URL=https://CHANGE_ME_YOUR_DOMAIN
NEXT_PUBLIC_APP_URL=https://CHANGE_ME_YOUR_DOMAIN
DATABASE_URL=postgresql://CHANGE_ME
AUTH_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
HOST=0.0.0.0
PORT=3000
GUEST_SESSION_DAYS=7
REDIS_URL=

RESEND_API_KEY=
EMAIL_FROM=Flirra <hello@CHANGE_ME_YOUR_DOMAIN>
ALLOW_DEV_EMAIL_LINKS=false

# Use test keys with PAYMENTS_LIVE=false during verification.
PAYMENTS_ENABLED=true
PAYMENTS_LIVE=false
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

STRIPE_IDENTITY_ENABLED=false
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_LIVE=false
STRIPE_ACCOUNT_ID=
PAYOUTS_ENABLED=false
PAYOUT_PROVIDER=

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
SITE_NAME=Flirra
