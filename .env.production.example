# Flirra production deployment template (Hostinger)
# Replace CHANGE_ME values. Never commit a real .env file or provider secret.

# Hostinger / application
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_URL=https://CHANGE_ME_YOUR_DOMAIN
NEXT_PUBLIC_APP_URL=https://CHANGE_ME_YOUR_DOMAIN
DATABASE_URL=postgresql://CHANGE_ME_HOSTINGER_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOSTINGER_HOST:5432/CHANGE_ME_DATABASE?schema=public
DIRECT_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DIRECT_HOST:5432/CHANGE_ME_DATABASE?schema=public
AUTH_SECRET=CHANGE_ME_RANDOM_SECRET_MINIMUM_32_CHARACTERS
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_MINIMUM_14_CHARACTERS
GUEST_SESSION_DAYS=7

# Optional infrastructure
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Legacy alias used by an admin status indicator; keep aligned if that code path is used.
TURN_SERVER_URL=

# Email (Resend is optional until email delivery is enabled)
RESEND_API_KEY=
EMAIL_FROM=Flirra <hello@CHANGE_ME_YOUR_DOMAIN>
ALLOW_DEV_EMAIL_LINKS=false

# Stripe coin checkout (server-side secrets; never expose these to the browser)
PAYMENTS_ENABLED=false
PAYMENTS_LIVE=false
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_SEPARATE_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# Stripe Connect / Identity / payouts are independent of coin checkout
STRIPE_ACCOUNT_ID=
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_LIVE=false
STRIPE_IDENTITY_ENABLED=false
PAYOUTS_ENABLED=false
PAYOUT_PROVIDER=

# Optional provider approval gates
PAYPAL_LIVE_APPROVED=false
ADAPTY_LIVE_APPROVED=false

# Optional integrations
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

SITE_NAME=Flirra

# QA_MEMBER_PASSWORD is only for the development-only QA seed script.
# Do not set it in production.
