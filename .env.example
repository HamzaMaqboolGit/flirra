# Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velora?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local administrator is created on first server start only when both are set.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-14-or-more-random-characters"

# Local / production infrastructure
REDIS_URL="redis://localhost:6379"
HOST="0.0.0.0"
PORT="3000"
GUEST_SESSION_DAYS="7"

# Email. Dev mode provides single-use verification/reset links in the API response unless disabled.
RESEND_API_KEY=""
EMAIL_FROM="Velora <hello@example.com>"
ALLOW_DEV_EMAIL_LINKS="true"

# Payments: requires approved business setup and Stripe live-mode approval.
PAYMENTS_ENABLED="false"
PAYMENTS_LIVE="false"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
SITE_NAME="Velora"

# Stripe identity and Connect require separate account capabilities and approval.
STRIPE_IDENTITY_ENABLED="false"
STRIPE_CONNECT_ENABLED="false"
STRIPE_CONNECT_LIVE="false"
PAYOUTS_ENABLED="false"
PAYOUT_PROVIDER=""

# WebRTC connectivity; TURN is necessary for reliable connections across restrictive NATs.
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Optional LibreTranslate-compatible endpoint for in-call message translation.
# Keep the provider key server-side; the browser calls Velora's authenticated API.
TRANSLATION_API_URL=""
TRANSLATION_API_KEY=""
# Required to store Stripe credentials from the admin panel (32+ random characters).
STRIPE_SETTINGS_ENCRYPTION_KEY="replace-with-a-separate-32-character-or-longer-secret"
